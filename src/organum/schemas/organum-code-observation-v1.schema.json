{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organum.dev/schemas/organum-code-observation-v1.schema.json",
  "$comment": "Structural projection. The Zod source and its cross-field refinements remain authoritative.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "organum-code/observation/v1"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ocobs-[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "timeout",
            "cancelled",
            "error"
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "timingCompleteness": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "comparisonKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "preregistrationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "attempt",
        "status",
        "startedAt",
        "finishedAt",
        "recordedAt",
        "timingCompleteness",
        "comparisonKey",
        "preregistrationId"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "canonicalCell": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!\\.)(?!.*\\.$)[a-z0-9._-]{1,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "joinStatus": {
          "type": "string",
          "enum": [
            "joined",
            "not-joined",
            "unknown"
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "persona": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!\\.)(?!.*\\.$)[a-z0-9._-]{1,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!\\.)(?!.*\\.$)[a-z0-9._-]{1,40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "canonicalCell",
        "joinStatus",
        "role",
        "persona",
        "workspace"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nativeSessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "protocol",
        "nativeSessionId"
      ],
      "additionalProperties": false
    },
    "brain": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effort": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "effort"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "model",
        "protocol",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "semantics": {
          "type": "string",
          "const": "organum-code/provider-usage/v1"
        },
        "source": {
          "type": "string",
          "enum": [
            "inference-broker",
            "native-passive",
            "unavailable"
          ]
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "lower-bound",
            "unavailable"
          ]
        },
        "requests": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "responses": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "semantics",
        "source",
        "completeness",
        "requests",
        "responses",
        "inputTokens",
        "outputTokens",
        "cachedInputTokens",
        "totalTokens",
        "reasoningTokens",
        "costUsd"
      ],
      "additionalProperties": false
    },
    "coordination": {
      "type": "object",
      "properties": {
        "contributions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "topic": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "publicationPhase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionClosed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]{1,512}$"
                },
                "bodyBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bodySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "file",
                "bodyBytes",
                "bodySha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contributions",
        "topic",
        "publicationPhase",
        "sessionClosed",
        "receipt"
      ],
      "additionalProperties": false
    },
    "discipline": {
      "type": "object",
      "properties": {
        "nativeToolApproval": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema": {
                  "type": "string",
                  "const": "organum-code/native-tool-approval-confound/v1"
                },
                "productSurface": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
                },
                "presentations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "allowOnce": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "rejectOnce": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "cancelled": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "latencyMs": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "sum": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400000
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400000
                    }
                  },
                  "required": [
                    "count",
                    "sum",
                    "max"
                  ],
                  "additionalProperties": false
                },
                "decider": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "human"
                            },
                            "presenter": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
                            }
                          },
                          "required": [
                            "kind",
                            "presenter"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "policy"
                            },
                            "policyId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
                            },
                            "policyVersion": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]{0,126}[A-Za-z0-9])?$"
                            }
                          },
                          "required": [
                            "kind",
                            "policyId",
                            "policyVersion"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "schema",
                "productSurface",
                "presentations",
                "allowOnce",
                "rejectOnce",
                "cancelled",
                "latencyMs",
                "decider"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "commands": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "declaredExecutions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "additionalReadOnlyCommands": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "strictSingleExecute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionBudgetPhase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointActuations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "conservationActuations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "worktreeClean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commands",
        "declaredExecutions",
        "additionalReadOnlyCommands",
        "strictSingleExecute",
        "executionBudgetPhase",
        "checkpointActuations",
        "conservationActuations",
        "worktreeClean"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "partial",
            "not-evaluated"
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "causalClaim": {
          "type": "string",
          "enum": [
            "observational",
            "controlled"
          ]
        },
        "checks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "gate",
        "classification",
        "causalClaim",
        "checks"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "observationSource": {
          "type": "string",
          "const": "reported"
        },
        "producer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "organum-code"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "commit"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "repositoryCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "priorFailure": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "backendId": {
                      "type": "string",
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
                    },
                    "nativeSessionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "runId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^ocobs-[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "backendId",
                    "nativeSessionId",
                    "runId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schema",
            "digest",
            "repositoryCommit",
            "priorFailure"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "observationSource",
        "producer",
        "source"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "scenario"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "run",
    "identity",
    "backend",
    "brain",
    "usage",
    "coordination",
    "discipline",
    "outcome",
    "provenance",
    "evaluation"
  ],
  "additionalProperties": false
}
